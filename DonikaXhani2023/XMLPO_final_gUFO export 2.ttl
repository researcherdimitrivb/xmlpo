@prefix : <http://example.com#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.com> .

<http://example.com> rdf:type owl:Ontology ;
                      owl:imports gufo: .

#################################################################
#    Object Properties
#################################################################

###  http://example.com#datasetHasData
:datasetHasData rdf:type owl:ObjectProperty ;
                rdfs:domain :Dataset ;
                rdfs:range :Data .


###  http://example.com#datasetHasFeature
:datasetHasFeature rdf:type owl:ObjectProperty ;
                   rdfs:domain :Dataset ;
                   rdfs:range :Feature .


###  http://example.com#datasetSplitHasTest
:datasetSplitHasTest rdf:type owl:ObjectProperty ;
                     rdfs:domain :DatasetSplit ;
                     rdfs:range :Test .


###  http://example.com#datasetSplitHasTrain
:datasetSplitHasTrain rdf:type owl:ObjectProperty ;
                      rdfs:domain :DatasetSplit ;
                      rdfs:range :Train .


###  http://example.com#explanationEvaluationHasExplanationFormatEvaluation
:explanationEvaluationHasExplanationFormatEvaluation rdf:type owl:ObjectProperty ;
                                                     rdfs:domain :ExplanationEvaluation ;
                                                     rdfs:range :ExplanationFormatEvaluation .


###  http://example.com#explanationEvaluationHasXaiEvaluationMetric
:explanationEvaluationHasXaiEvaluationMetric rdf:type owl:ObjectProperty ;
                                             rdfs:domain :ExplanationEvaluation ;
                                             rdfs:range :XAIEvaluationMetric .


###  http://example.com#explanationHasExplanationApproach
:explanationHasExplanationApproach rdf:type owl:ObjectProperty ;
                                   rdfs:domain :Explanation ;
                                   rdfs:range :ExplanationApproach .


###  http://example.com#explanationHasExplanationFormat
:explanationHasExplanationFormat rdf:type owl:ObjectProperty ;
                                 rdfs:domain :Explanation ;
                                 rdfs:range :ExplanationFormat .


###  http://example.com#preprocessingAlgorithmHasDataCleaning
:preprocessingAlgorithmHasDataCleaning rdf:type owl:ObjectProperty ;
                                       rdfs:domain :PreprocessingAlgorithm ;
                                       rdfs:range :DataCleaning .


###  http://purl.org/nemo/gufo#inheresIn
gufo:inheresIn rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#isEventProperPartOf
gufo:isEventProperPartOf rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#mediates
gufo:mediates rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#participatedIn
gufo:participatedIn rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#wasCreatedIn
gufo:wasCreatedIn rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://example.com#ModelCharacteristic
:ModelCharacteristic rdf:type owl:DatatypeProperty ;
                     rdfs:domain :XAIModel ;
                     rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://example.com#Addresses
:Addresses rdf:type owl:Class ;
           rdfs:subClassOf gufo:Relator ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:mediates ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Goal
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:mediates ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :MLAlgorithm
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:mediates ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :MLAlgorithm_1
                           ] .


###  http://example.com#Algorithm
:Algorithm rdf:type owl:Class ;
           rdfs:subClassOf gufo:FunctionalComplex ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty [ owl:inverseOf gufo:inheresIn
                                            ] ;
                             owl:someValuesFrom :AlgorithmCharacteristic
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:inheresIn ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :AlgorithmCharacteristic
                           ] .


###  http://example.com#AlgorithmCharacteristic
:AlgorithmCharacteristic rdf:type owl:Class ;
                         rdfs:subClassOf gufo:Quality ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:inheresIn ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :Algorithm
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                          ] ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :Algorithm
                                         ] .


###  http://example.com#AntehocAprroach
:AntehocAprroach rdf:type owl:Class ;
                 rdfs:subClassOf :ExplanationApproach .


###  http://example.com#AntehocImplementation
:AntehocImplementation rdf:type owl:Class ;
                       rdfs:subClassOf :Implementation ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                        ] ;
                                         owl:someValuesFrom :AntehocAprroach
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                        ] ;
                                         owl:someValuesFrom :MLModel
                                       ] .


###  http://example.com#Assesses
:Assesses rdf:type owl:Class ;
          rdfs:subClassOf gufo:Relator ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty gufo:mediates ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :MLModel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty gufo:mediates ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :ModelEvaluationTechnique
                          ] .


###  http://example.com#BlackboxMLmodel
:BlackboxMLmodel rdf:type owl:Class ;
                 rdfs:subClassOf :MLModel ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gufo:mediates ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Vizualization
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty [ owl:inverseOf gufo:wasCreatedIn
                                                  ] ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :MLModelImplementation
                                 ] .


###  http://example.com#CategoricalFeature
:CategoricalFeature rdf:type owl:Class ;
                    rdfs:subClassOf :Feature .


###  http://example.com#ClassPredictionEvaluationMeasure
:ClassPredictionEvaluationMeasure rdf:type owl:Class ;
                                  rdfs:subClassOf :PredictiveModelEvaluationMeasure .


###  http://example.com#ClassificationAlgorithm
:ClassificationAlgorithm rdf:type owl:Class ;
                         rdfs:subClassOf :SupervisedLearningApproach .


###  http://example.com#ClusteringAlgorithm
:ClusteringAlgorithm rdf:type owl:Class ;
                     rdfs:subClassOf :UnsupervisedLearningApproach .


###  http://example.com#ClusteringEvaluationMeasure
:ClusteringEvaluationMeasure rdf:type owl:Class ;
                             rdfs:subClassOf :ModelEvaluationTechnique .


###  http://example.com#Correlates
:Correlates rdf:type owl:Class ;
            rdfs:subClassOf gufo:Relator ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty [ owl:inverseOf gufo:inheresIn
                                             ] ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :CorrelationCharacteristic
                            ] .


###  http://example.com#CorrelationCharacteristic
:CorrelationCharacteristic rdf:type owl:Class ;
                           rdfs:subClassOf gufo:Quality ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty gufo:inheresIn ;
                                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass :Correlates
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                            ] ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass :CorrelationCoefficient
                                           ] .


###  http://example.com#CorrelationCoefficient
:CorrelationCoefficient rdf:type owl:Class ;
                        rdfs:subClassOf :NumericalPredictionEvaluationMeasure ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty gufo:inheresIn ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass :CorrelationCharacteristic
                                        ] .


###  http://example.com#Data
:Data rdf:type owl:Class ;
      rdfs:subClassOf gufo:FunctionalComplex ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty [ owl:inverseOf gufo:inheresIn
                                       ] ;
                        owl:someValuesFrom :DataCharacteristic
                      ] .


###  http://example.com#DataCharacteristic
:DataCharacteristic rdf:type owl:Class ;
                    rdfs:subClassOf gufo:Quality ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty gufo:inheresIn ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Data
                                    ] .


###  http://example.com#DataCleaning
:DataCleaning rdf:type owl:Class ;
              rdfs:subClassOf gufo:Event ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:inheresIn ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :DataCleaningCharacteristic
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:isEventProperPartOf ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :DropFeaturesrows
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:isEventProperPartOf ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :ImputeMissingvalues
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:wasCreatedIn ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :ProcessedData
                              ] .


###  http://example.com#DataCleaningCharacteristic
:DataCleaningCharacteristic rdf:type owl:Class ;
                            rdfs:subClassOf gufo:Quality ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                             ] ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass :DataCleaning
                                            ] .


###  http://example.com#Dataset
:Dataset rdf:type owl:Class ;
         rdfs:subClassOf gufo:FunctionalComplex ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty gufo:inheresIn ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :DatasetCharacteristic
                         ] .


###  http://example.com#DatasetCharacteristic
:DatasetCharacteristic rdf:type owl:Class ;
                       rdfs:subClassOf gufo:Quality ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                        ] ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :Dataset
                                       ] .


###  http://example.com#DatasetSplit
:DatasetSplit rdf:type owl:Class ;
              rdfs:subClassOf gufo:Event ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:participatedIn
                                               ] ;
                                owl:someValuesFrom :Algorithm
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:participatedIn
                                               ] ;
                                owl:someValuesFrom :Dataset
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:participatedIn
                                               ] ;
                                owl:someValuesFrom :ProcessedData
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:wasCreatedIn
                                               ] ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :TestSet
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:wasCreatedIn
                                               ] ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :TrainSet
                              ] .


###  http://example.com#DependentFeature
:DependentFeature rdf:type owl:Class ;
                  rdfs:subClassOf :Feature .


###  http://example.com#DropFeaturesrows
:DropFeaturesrows rdf:type owl:Class ;
                  rdfs:subClassOf gufo:Event ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf gufo:isEventProperPartOf
                                                   ] ;
                                    owl:someValuesFrom :DataCleaning
                                  ] .


###  http://example.com#DummyEnconding
:DummyEnconding rdf:type owl:Class ;
                rdfs:subClassOf :FeatureEncondingTechnique .


###  http://example.com#DummyFeature
:DummyFeature rdf:type owl:Class ;
              rdfs:subClassOf :Feature ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:wasCreatedIn
                                               ] ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :FeatureEnconding
                              ] .


###  http://example.com#ErrorBasedEvaluationMeasure
:ErrorBasedEvaluationMeasure rdf:type owl:Class ;
                             rdfs:subClassOf :NumericalPredictionEvaluationMeasure .


###  http://example.com#EvaluatesExplanationFormat
:EvaluatesExplanationFormat rdf:type owl:Class ;
                            rdfs:subClassOf gufo:Relator ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty gufo:mediates ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass :ExplanationFormatEvaluation
                                            ] .


###  http://example.com#EvaluationMeasure
:EvaluationMeasure rdf:type owl:Class ;
                   rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#EvaluationProcedure
:EvaluationProcedure rdf:type owl:Class ;
                     rdfs:subClassOf :Algorithm .


###  http://example.com#Experiment
:Experiment rdf:type owl:Class ;
            rdfs:subClassOf gufo:Event ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty [ owl:inverseOf gufo:inheresIn
                                             ] ;
                              owl:someValuesFrom :ExperimentCharacteristic
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty [ owl:inverseOf gufo:isEventProperPartOf
                                             ] ;
                              owl:someValuesFrom :Workflow
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty [ owl:inverseOf gufo:participatedIn
                                             ] ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Goal
                            ] .


###  http://example.com#ExperimentCharacteristic
:ExperimentCharacteristic rdf:type owl:Class ;
                          rdfs:subClassOf gufo:Quality ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty gufo:inheresIn ;
                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass :Experiment
                                          ] .


###  http://example.com#Explain
:Explain rdf:type owl:Class ;
         rdfs:subClassOf gufo:Event ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty [ owl:inverseOf gufo:participatedIn
                                          ] ;
                           owl:someValuesFrom :Explanation
                         ] .


###  http://example.com#Explanation
:Explanation rdf:type owl:Class ;
             rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#ExplanationApproach
:ExplanationApproach rdf:type owl:Class ;
                     rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#ExplanationEvaluation
:ExplanationEvaluation rdf:type owl:Class ;
                       rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#ExplanationFormat
:ExplanationFormat rdf:type owl:Class ;
                   rdfs:subClassOf gufo:FunctionalComplex ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gufo:mediates ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :EvaluatesExplanationFormat
                                   ] .


###  http://example.com#ExplanationFormatEvaluation
:ExplanationFormatEvaluation rdf:type owl:Class ;
                             rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#ExplanationScope
:ExplanationScope rdf:type owl:Class ;
                  rdfs:subClassOf :Explanation .


###  http://example.com#Feature
:Feature rdf:type owl:Class ;
         rdfs:subClassOf gufo:FunctionalComplex ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty gufo:inheresIn ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :FeatureCharacteristic
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty gufo:mediates ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Correlates
                         ] .


###  http://example.com#FeatureCharacteristic
:FeatureCharacteristic rdf:type owl:Class ;
                       rdfs:subClassOf gufo:Quality ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                        ] ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :Feature
                                       ] .


###  http://example.com#FeatureEncodingCharacteristic
:FeatureEncodingCharacteristic rdf:type owl:Class ;
                               rdfs:subClassOf gufo:Quality ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                                ] ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass :FeatureEnconding
                                               ] .


###  http://example.com#FeatureEnconding
:FeatureEnconding rdf:type owl:Class ;
                  rdfs:subClassOf gufo:Event ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                   ] ;
                                    owl:someValuesFrom :Algorithm
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                   ] ;
                                    owl:someValuesFrom :CategoricalFeature
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                   ] ;
                                    owl:someValuesFrom :FeatureEncondingTechnique
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty gufo:inheresIn ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :FeatureEncodingCharacteristic
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty gufo:wasCreatedIn ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :DummyFeature
                                  ] .


###  http://example.com#FeatureEncondingTechnique
:FeatureEncondingTechnique rdf:type owl:Class ;
                           rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#FeatureScaledData
:FeatureScaledData rdf:type owl:Class ;
                   rdfs:subClassOf :Data ,
