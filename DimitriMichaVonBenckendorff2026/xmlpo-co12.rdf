        <owl:versionInfo>1.0</owl:versionInfo>
        <terms:title xml:lang="en">XMLPO Stakeholder-Centred Explainability Extension</terms:title>
        <terms:description xml:lang="en">[1–2 sentence scope statement]</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:creator>Dimitri Micha von Benckendorff https://orcid.org/0009-0000-3872-8046</terms:creator>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-31</terms:created>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-31</terms:issued>
        <terms:bibliographicCitation>[thesis / repo citation once available]</terms:bibliographicCitation>
        <terms:publisher rdf:resource="https://ror.org/006hf6230"/>
        <terms:source rdf:resource="http://example.org/xmlpo"/>
        <vann:preferredNamespacePrefix>xmlpo-co12</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://example.org/xmlpo#</vann:preferredNamespaceUri>
        <bibo:doi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10.xxxx/xxxxx</bibo:doi>
        <bibo:status>draft</bibo:status>
    </owl:Ontology>

