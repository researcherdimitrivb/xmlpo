    <!-- http://example.com#KnowledgeLevels -->

    <owl:Class rdf:about="http://example.com#KnowledgeLevels">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.com#Advanced"/>
                    <rdf:Description rdf:about="http://example.com#Basic"/>
                    <rdf:Description rdf:about="http://example.com#Expert"/>
                    <rdf:Description rdf:about="http://example.com#Intermediate"/>
                    <rdf:Description rdf:about="http://example.com#None"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#QualityValue"/>
    </owl:Class>
    


