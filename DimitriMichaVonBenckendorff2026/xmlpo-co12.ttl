###  http://example.com#DimitriMichaVonBenckendorff
:DimitriMichaVonBenckendorff rdf:type owl:NamedIndividual ,
                                      :ResearcherTheorist ;
                             rdf:label "Dimitri Micha von Benckendorff"@en ;
                             rdfs:comment "This person works as a researcher at the University of Twente."@en .


###  http://example.com#Discover
:Discover rdf:type owl:NamedIndividual ,
                   gufo:SubKind .


###  http://example.com#DomainExpert
:DomainExpert rdf:type owl:NamedIndividual ,
                       gufo:Role .


###  http://example.com#DomainKnowledge
:DomainKnowledge rdf:type owl:NamedIndividual ,
                          gufo:SubKind .


###  http://example.com#Expert
:Expert rdf:type owl:NamedIndividual ,
                 :KnowledgeLevels ;
        rdf:label "[object Object]" .


###  http://example.com#Explanation
:Explanation rdf:type owl:NamedIndividual ,
                      gufo:Kind .


###  http://example.com#ExplanationAssessmentPerspective
:ExplanationAssessmentPerspective rdf:type owl:NamedIndividual ,
                                           gufo:Kind .


###  http://example.com#ExplanationGeneration
:ExplanationGeneration rdf:type owl:NamedIndividual ,
                                gufo:EventType .


###  http://example.com#ExplanationGoal
:ExplanationGoal rdf:type owl:NamedIndividual ,
                          gufo:Kind .


###  http://example.com#ExplanationGoalPriority
:ExplanationGoalPriority rdf:type owl:NamedIndividual ,
                                  gufo:Kind .


###  http://example.com#ExplanationIntention
:ExplanationIntention rdf:type owl:NamedIndividual ,
