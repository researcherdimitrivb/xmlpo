@prefix : <http://example.com#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.com#> .

<http://example.com> rdf:type owl:Ontology ;
                      owl:imports gufo: .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#label
rdf:label rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.com#DimensionOf
:DimensionOf rdf:type owl:ObjectProperty ;
             rdfs:domain :PresentationDimension ;
             rdfs:range :Composition ;
             rdfs:label "DimensionOf"@en .


###  http://example.com#DimensionOf_1
:DimensionOf_1 rdf:type owl:ObjectProperty ;
               rdfs:domain :UserDimension ;
               rdfs:range :Coherence ;
               rdfs:label "DimensionOf"@en .


###  http://example.com#DimensionOf_2
:DimensionOf_2 rdf:type owl:ObjectProperty ;
               rdfs:domain :ContentDimension ;
               rdfs:range :Consistency ;
               rdfs:label "DimensionOf"@en .


###  http://example.com#expresses
:expresses rdf:type owl:ObjectProperty ;
           rdfs:domain :ExplanationArtifact ;
           rdfs:range :epExplanation ;
           rdfs:label "expresses"@en .


###  http://example.com#fidelityPerspectiveHasConsistency
:fidelityPerspectiveHasConsistency rdf:type owl:ObjectProperty ;
                                   rdfs:domain :FidelityPerspective ;
                                   rdfs:range :Consistency ;
                                   rdfs:label ""@en .


###  http://example.com#fidelityPerspectiveHasCorrectness
:fidelityPerspectiveHasCorrectness rdf:type owl:ObjectProperty ;
                                   rdfs:domain :FidelityPerspective ;
                                   rdfs:range :Correctness ;
                                   rdfs:label ""@en .


###  http://example.com#level
:level rdf:type owl:ObjectProperty ;
       rdfs:subPropertyOf gufo:hasReifiedQualityValue ;
       rdfs:domain :Knowledge ;
       rdfs:range :KnowledgeLevels ;
       rdfs:label "level"@en .


###  http://example.com#supports
:supports rdf:type owl:ObjectProperty ;
          rdfs:domain :ComprehensibilityPerspective ;
          rdfs:range :Coherence ;
          rdfs:label "supports"@en .


###  http://example.com#supports_1
:supports_1 rdf:type owl:ObjectProperty ;
            rdfs:domain :FidelityPerspective ;
            rdfs:range :Completeness ;
            rdfs:label "supports"@en .


###  http://example.com#1
<http://example.com#1> rdf:type owl:ObjectProperty ;
                       rdfs:domain :ContentDimension ;
                       rdfs:range :Contrastivity .


###  http://example.com#1_1
<http://example.com#1_1> rdf:type owl:ObjectProperty ;
                         rdfs:domain :UserDimension ;
                         rdfs:range :Controllability .


###  http://example.com#1_10
<http://example.com#1_10> rdf:type owl:ObjectProperty ;
                          rdfs:domain :UserDimension ;
                          rdfs:range :Context .


###  http://example.com#1_11
<http://example.com#1_11> rdf:type owl:ObjectProperty ;
                          rdfs:domain :ContentDimension ;
                          rdfs:range :CovariateComplexity .


###  http://example.com#1_2
<http://example.com#1_2> rdf:type owl:ObjectProperty ;
                         rdfs:domain :ComprehensibilityPerspective ;
                         rdfs:range :CovariateComplexity .


###  http://example.com#1_3
<http://example.com#1_3> rdf:type owl:ObjectProperty ;
                         rdfs:domain :ContentDimension ;
                         rdfs:range :Completeness .


###  http://example.com#1_4
<http://example.com#1_4> rdf:type owl:ObjectProperty ;
                         rdfs:domain :ComprehensibilityPerspective ;
                         rdfs:range :Context .


###  http://example.com#1_5
<http://example.com#1_5> rdf:type owl:ObjectProperty ;
                         rdfs:domain :PresentationDimension ;
                         rdfs:range :Compactness .


###  http://example.com#1_6
<http://example.com#1_6> rdf:type owl:ObjectProperty ;
                         rdfs:domain :ContentDimension ;
                         rdfs:range :Correctness .


###  http://example.com#1_7
<http://example.com#1_7> rdf:type owl:ObjectProperty ;
                         rdfs:domain :Confidence ;
                         rdfs:range :PresentationDimension .


###  http://example.com#1_8
<http://example.com#1_8> rdf:type owl:ObjectProperty ;
                         rdfs:domain :ContentDimension ;
                         rdfs:range :Continuity .


###  http://example.com#1_9
<http://example.com#1_9> rdf:type owl:ObjectProperty ;
                         rdfs:domain :ComprehensibilityPerspective ;
                         rdfs:range :Confidence .


#################################################################
#    Data properties
#################################################################

###  http://example.com#rank
:rank rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf gufo:hasQualityValue ;
      rdfs:domain :ExplanationQualityPriority ;
      rdfs:label "rank"@en .


###  http://example.com#rank_1
:rank_1 rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf gufo:hasQualityValue ;
        rdfs:domain :ExplanationTypePriority ;
        rdfs:label "rank"@en .


###  http://example.com#rank_2
:rank_2 rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf gufo:hasQualityValue ;
        rdfs:domain :ExplanationGoalPriority ;
        rdfs:label "rank"@en .


#################################################################
#    Classes
#################################################################

###  http://example.com#Aligns
:Aligns rdf:type owl:Class ;
        rdfs:subClassOf gufo:Relator ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty gufo:mediates ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :ExplanationGoal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty gufo:mediates ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :ExplanationType
                        ] .


###  http://example.com#Audit
:Audit rdf:type owl:Class ;
       rdfs:subClassOf :ExplanationGoal .


###  http://example.com#CalibrateTrust
:CalibrateTrust rdf:type owl:Class ;
                rdfs:subClassOf :ExplanationGoal .


###  http://example.com#Coherence
:Coherence rdf:type owl:Class ;
           rdfs:subClassOf :ExplanationQuality .


###  http://example.com#Compactness
:Compactness rdf:type owl:Class ;
             rdfs:subClassOf :ExplanationQuality .


###  http://example.com#Completeness
:Completeness rdf:type owl:Class ;
              rdfs:subClassOf :ExplanationQuality .


###  http://example.com#Composition
:Composition rdf:type owl:Class ;
             rdfs:subClassOf :ExplanationQuality .


###  http://example.com#ComprehensibilityPerspective
:ComprehensibilityPerspective rdf:type owl:Class ;
                              rdfs:subClassOf :ExplanationAssessmentPerspective .


###  http://example.com#Confidence
:Confidence rdf:type owl:Class ;
            rdfs:subClassOf :ExplanationQuality .


###  http://example.com#Consistency
:Consistency rdf:type owl:Class ;
             rdfs:subClassOf :ExplanationQuality .


###  http://example.com#ContentDimension
:ContentDimension rdf:type owl:Class ;
                  rdfs:subClassOf :ExplanationQualityDimension .


###  http://example.com#Contest
:Contest rdf:type owl:Class ;
         rdfs:subClassOf :ExplanationGoal .


###  http://example.com#Context
:Context rdf:type owl:Class ;
         rdfs:subClassOf :ExplanationQuality .


###  http://example.com#Continuity
:Continuity rdf:type owl:Class ;
            rdfs:subClassOf :ExplanationQuality .


###  http://example.com#Contrastivity
:Contrastivity rdf:type owl:Class ;
               rdfs:subClassOf :ExplanationQuality .


###  http://example.com#Controllability
:Controllability rdf:type owl:Class ;
                 rdfs:subClassOf :ExplanationQuality .


###  http://example.com#Correctness
:Correctness rdf:type owl:Class ;
             rdfs:subClassOf :ExplanationQuality .


###  http://example.com#CovariateComplexity
:CovariateComplexity rdf:type owl:Class ;
                     rdfs:subClassOf :ExplanationQuality .


###  http://example.com#DecisionSubject
:DecisionSubject rdf:type owl:Class ;
                 rdfs:subClassOf :XAIStakeholder .


###  http://example.com#DecisionSupport
:DecisionSupport rdf:type owl:Class ;
                 rdfs:subClassOf :ExplanationGoal .


###  http://example.com#Discover
:Discover rdf:type owl:Class ;
          rdfs:subClassOf :ExplanationGoal .


###  http://example.com#DomainExpert
:DomainExpert rdf:type owl:Class ;
              rdfs:subClassOf :XAIStakeholder .


###  http://example.com#DomainKnowledge
:DomainKnowledge rdf:type owl:Class ;
                 rdfs:subClassOf :Knowledge .


###  http://example.com#Explanation
:Explanation rdf:type owl:Class ;
             rdfs:subClassOf gufo:Relator .


###  http://example.com#ExplanationArtifact
:ExplanationArtifact rdf:type owl:Class ;
                     rdfs:subClassOf gufo:FunctionalComplex ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                      ] ;
                                       owl:someValuesFrom :xmlpoExplain
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty gufo:inheresIn ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :ExplanationQuality
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty gufo:inheresIn ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :xmlpoExplanationModality
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty gufo:inheresIn ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :xmlpoExplanationScope
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty [ owl:inverseOf gufo:wasCreatedIn
                                                      ] ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :ExplanationGeneration
                                     ] ;
                     rdfs:comment "An artifact generated by an explanation process that expresses an explanation and can be assessed according to quality criteria."@en ;
                     rdfs:label "ExplanationArtifact"@en .


###  http://example.com#ExplanationAssessmentPerspective
:ExplanationAssessmentPerspective rdf:type owl:Class ;
                                  rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#ExplanationGeneration
:ExplanationGeneration rdf:type owl:Class ;
                       rdfs:subClassOf gufo:Event ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty gufo:wasCreatedIn ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :ExplanationArtifact
                                       ] .


###  http://example.com#ExplanationGoal
:ExplanationGoal rdf:type owl:Class ;
                 rdfs:subClassOf gufo:IntrinsicMode ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gufo:externallyDependsOn ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :ExplanationIntention
                                 ] .


###  http://example.com#ExplanationGoalPriority
:ExplanationGoalPriority rdf:type owl:Class ;
                         rdfs:subClassOf gufo:Relator ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:mediates ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :ExplanationGoal
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:mediates ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :XAIStakeholder
                                         ] .


###  http://example.com#ExplanationIntention
:ExplanationIntention rdf:type owl:Class ;
                      rdfs:subClassOf gufo:IntrinsicMode ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty [ owl:inverseOf gufo:externallyDependsOn
                                                       ] ;
                                        owl:someValuesFrom :ExplanationGoal
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty gufo:inheresIn ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :XAIStakeholder
                                      ] .


###  http://example.com#ExplanationModalityPriority
:ExplanationModalityPriority rdf:type owl:Class ;
                             rdfs:subClassOf gufo:Relator ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty gufo:mediates ;
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass :XAIStakeholder
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty gufo:mediates ;
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass :xmlpoExplanationModality
                                             ] .


###  http://example.com#ExplanationQuality
:ExplanationQuality rdf:type owl:Class ;
                    rdfs:subClassOf gufo:Quality .


###  http://example.com#ExplanationQualityDimension
:ExplanationQualityDimension rdf:type owl:Class ;
                             rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#ExplanationQualityPriority
:ExplanationQualityPriority rdf:type owl:Class ;
                            rdfs:subClassOf gufo:Relator ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty gufo:mediates ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass :ExplanationQuality
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty gufo:mediates ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass :XAIStakeholder
                                            ] .


###  http://example.com#ExplanationType
:ExplanationType rdf:type owl:Class ;
                 rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://example.com#ExplanationTypePriority
:ExplanationTypePriority rdf:type owl:Class ;
                         rdfs:subClassOf gufo:Relator ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:mediates ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :ExplanationType
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:mediates ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :XAIStakeholder
                                         ] .


###  http://example.com#FidelityPerspective
:FidelityPerspective rdf:type owl:Class ;
                     rdfs:subClassOf :ExplanationAssessmentPerspective .


###  http://example.com#Handles
:Handles rdf:type owl:Class ;
         rdfs:subClassOf gufo:Relator ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty gufo:mediates ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :XAIStakeholder
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty gufo:mediates ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :xmlpoExplanationModality
                         ] .


###  http://example.com#Improve
:Improve rdf:type owl:Class ;
         rdfs:subClassOf :ExplanationGoal .


###  http://example.com#Justify
:Justify rdf:type owl:Class ;
         rdfs:subClassOf :ExplanationGoal .


###  http://example.com#Knowledge
:Knowledge rdf:type owl:Class ;
           rdfs:subClassOf gufo:IntrinsicMode ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:inheresIn ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Person
                           ] .


###  http://example.com#KnowledgeLevels
:KnowledgeLevels rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( :Advanced
                                                   :Basic
                                                   :Expert
                                                   :Intermediate
                                                   :None
                                                 )
                                     ] ;
                 rdfs:subClassOf gufo:QualityValue .


###  http://example.com#OperationalUser
:OperationalUser rdf:type owl:Class ;
                 rdfs:subClassOf :XAIStakeholder .


###  http://example.com#OrganisationalComplianceOverseer
:OrganisationalComplianceOverseer rdf:type owl:Class ;
                                  rdfs:subClassOf :XAIStakeholder .


###  http://example.com#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#Persuade
:Persuade rdf:type owl:Class ;
          rdfs:subClassOf :ExplanationGoal .


###  http://example.com#PresentationDimension
:PresentationDimension rdf:type owl:Class ;
                       rdfs:subClassOf :ExplanationQualityDimension .


###  http://example.com#ResearcherTheorist
:ResearcherTheorist rdf:type owl:Class ;
                    rdfs:subClassOf :XAIStakeholder .


###  http://example.com#Supports
:Supports rdf:type owl:Class ;
          rdfs:subClassOf gufo:Relator ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty gufo:mediates ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :ExplanationArtifact
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty gufo:mediates ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :XAIStakeholder
                          ] .


###  http://example.com#TechnicalCreator
:TechnicalCreator rdf:type owl:Class ;
                  rdfs:subClassOf :XAIStakeholder .


###  http://example.com#TechnicalKnowledge
:TechnicalKnowledge rdf:type owl:Class ;
                    rdfs:subClassOf :Knowledge .


###  http://example.com#UserDimension
:UserDimension rdf:type owl:Class ;
               rdfs:subClassOf :ExplanationQualityDimension .


###  http://example.com#XAIStakeholder
:XAIStakeholder rdf:type owl:Class ;
                rdfs:subClassOf :Person .


###  http://example.com#epExplanation
:epExplanation rdf:type owl:Class ;
               rdfs:subClassOf gufo:Relator .


###  http://example.com#xmlpoExplain
:xmlpoExplain rdf:type owl:Class ;
              rdfs:subClassOf gufo:Event .


###  http://example.com#xmlpoExplanationEvaluation
:xmlpoExplanationEvaluation rdf:type owl:Class ;
                            rdfs:subClassOf gufo:Event ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                             ] ;
                                              owl:someValuesFrom :ExplanationArtifact
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                             ] ;
                                              owl:someValuesFrom :ExplanationQuality
                                            ] .


###  http://example.com#xmlpoExplanationModality
:xmlpoExplanationModality rdf:type owl:Class ;
                          rdfs:subClassOf gufo:Quality ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                           ] ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass :ExplanationArtifact
                                          ] .


###  http://example.com#xmlpoExplanationScope
:xmlpoExplanationScope rdf:type owl:Class ;
                       rdfs:subClassOf gufo:Quality ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                        ] ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :ExplanationArtifact
                                       ] .


###  http://example.com#xmlpoMLModel
:xmlpoMLModel rdf:type owl:Class ;
              rdfs:subClassOf gufo:FunctionalComplex ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:participatedIn ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :ExplanationGeneration
                              ] .


###  http://example.com#xmlpoXAIModel
:xmlpoXAIModel rdf:type owl:Class ;
               rdfs:subClassOf gufo:FunctionalComplex ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty gufo:participatedIn ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :ExplanationGeneration
                               ] .


