#################################################################
#    Object Properties
#################################################################

###  http://example.com#derivedFrom
:derivedFrom rdf:type owl:ObjectProperty ;
             rdfs:domain :HemoglobinMeasurementResult ;
             rdfs:range :HgbFeature ;
             rdfs:label "derivedFrom"@en .


###  http://example.com#hasDisorder
:hasDisorder rdf:type owl:ObjectProperty ;
             rdfs:domain :ncitPatient ;
             rdfs:range :ncitDisorder ;
             rdfs:label "hasDisorder"@en .


###  http://example.com#hasProcedure
:hasProcedure rdf:type owl:ObjectProperty ;
              rdfs:domain :CANScreening ;
              rdfs:range :CART ;
              rdfs:label "hasProcedure"@en .


###  http://example.com#hasScore
:hasScore rdf:type owl:ObjectProperty ;
          rdfs:domain :CANRiskScore ;
          rdfs:range :RiskAssessmentForCAN ;
          rdfs:label "hasScore"@en .


###  http://example.com#hasScore_1
:hasScore_1 rdf:type owl:ObjectProperty ;
            rdfs:domain :HealthRiskScore ;
            rdfs:range :ncitHealthRiskAssessment ;
            rdfs:label "hasScore"@en .


###  http://example.com#manifestationOf
:manifestationOf rdf:type owl:ObjectProperty ;
                 rdfs:domain :ncitDiabeticNeuropathy ;
                 rdfs:range :ncitDiabetesMellitus ;
                 rdfs:label "manifestationOf"@en .


###  http://example.com#ncittreats
:ncittreats rdf:type owl:ObjectProperty ;
            rdfs:domain :ncitDiabetesTherapy ;
            rdfs:range :ncitDiabetesMellitus ;
            rdfs:label "ncit:treats"@en .


###  http://example.com#riskAssessmentForCanHasXmlpoResult
:riskAssessmentForCanHasXmlpoResult rdf:type owl:ObjectProperty ;
                                    rdfs:domain :RiskAssessmentForCAN ;
                                    rdfs:range :xmlpoResult .


###  http://example.com#treats
:treats rdf:type owl:ObjectProperty ;
        rdfs:domain :ncitNurse ;
        rdfs:range :ncitPatient .


#################################################################
#    Data properties
#################################################################

###  http://example.com#hasUnit
:hasUnit rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf gufo:hasQualityValue ,
                            owl:topDataProperty ;
         rdfs:domain :HemoglobinMeasurementResult ;
         rdfs:label "hasUnit"@en .


###  http://example.com#hasValue
:hasValue rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf gufo:hasQualityValue ,
                             owl:topDataProperty ;
          rdfs:domain :HemoglobinMeasurementResult ;
          rdfs:label "hasValue"@en .


#################################################################
#    Classes
#################################################################

###  http://example.com#CANRiskScore
:CANRiskScore rdf:type owl:Class ;
              rdfs:subClassOf :HealthRiskScore .


###  http://example.com#CANScreening
:CANScreening rdf:type owl:Class ;
              rdfs:subClassOf :ncitScreening ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:wasCreatedIn
                                               ] ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :RiskAssessmentForCAN
                              ] .


###  http://example.com#CART
:CART rdf:type owl:Class ;
      rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#ClinicalFeature
:ClinicalFeature rdf:type owl:Class ;
                 rdfs:subClassOf :xmlpoFeature .


###  http://example.com#ClinicalMeasurement
:ClinicalMeasurement rdf:type owl:Class ;
                     rdfs:subClassOf :Measurement .


###  http://example.com#ClinicalMeasurementResult
:ClinicalMeasurementResult rdf:type owl:Class ;
                           rdfs:subClassOf :MeasurementResult .


###  http://example.com#HealthRiskScore
:HealthRiskScore rdf:type owl:Class ;
                 rdfs:subClassOf :ncitClinicalOrResearchAssessmentScore .


###  http://example.com#HemoglobinConcentration
:HemoglobinConcentration rdf:type owl:Class ;
                         rdfs:subClassOf gufo:Quality ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:inheresIn ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :ncitHemoglobinMeasurement
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                          ] ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :ncitHemoglobin
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                          ] ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :ncitPatient
                                         ] .


###  http://example.com#HemoglobinMeasurementResult
:HemoglobinMeasurementResult rdf:type owl:Class ;
                             rdfs:subClassOf :ClinicalMeasurementResult ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty [ owl:inverseOf gufo:wasCreatedIn
                                                              ] ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass :ncitHemoglobinMeasurement
                                             ] .


###  http://example.com#HgbFeature
:HgbFeature rdf:type owl:Class ;
            rdfs:subClassOf :ClinicalFeature .


###  http://example.com#Measurement
:Measurement rdf:type owl:Class ;
             rdfs:subClassOf gufo:Event .


###  http://example.com#MeasurementResult
:MeasurementResult rdf:type owl:Class ;
                   rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf gufo:FunctionalComplex .


###  http://example.com#RiskAssessmentForCAN
:RiskAssessmentForCAN rdf:type owl:Class ;
                      rdfs:subClassOf :ncitHealthRiskAssessment ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty gufo:wasCreatedIn ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :CANScreening
                                      ] .


###  http://example.com#ncitClinicalOrResearchAssessmentScore
:ncitClinicalOrResearchAssessmentScore rdf:type owl:Class ;
                                       rdfs:subClassOf gufo:Quality .


###  http://example.com#ncitDiabetesMellitus
:ncitDiabetesMellitus rdf:type owl:Class ;
                      rdfs:subClassOf :ncitMetabolicDisorder .


###  http://example.com#ncitDiabetesTherapy
:ncitDiabetesTherapy rdf:type owl:Class ;
                     rdfs:subClassOf :ncitTherapeuticTherapy .


###  http://example.com#ncitDiabeticAutonomicNeuropathy
:ncitDiabeticAutonomicNeuropathy rdf:type owl:Class ;
                                 rdfs:subClassOf :ncitDiabeticNeuropathy ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                                  ] ;
                                                   owl:someValuesFrom :CANScreening
                                                 ] .


###  http://example.com#ncitDiabeticNeuropathy
:ncitDiabeticNeuropathy rdf:type owl:Class ;
                        rdfs:subClassOf :ncitNeuropathy .


###  http://example.com#ncitDisorder
:ncitDisorder rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty owl:sameAs ;
                                    owl:someValuesFrom <http://purl.obolibrary.org/obo/NCIT_C2991>
                                  ] ;
              rdfs:subClassOf gufo:FunctionalComplex ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:participatedIn
                                               ] ;
                                owl:someValuesFrom :ncitScreening
                              ] .


###  http://example.com#ncitHealthRiskAssessment
:ncitHealthRiskAssessment rdf:type owl:Class ;
                          rdfs:subClassOf gufo:FunctionalComplex ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty [ owl:inverseOf gufo:wasCreatedIn
                                                           ] ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass :ncitScreening
                                          ] .


###  http://example.com#ncitHemoglobin
:ncitHemoglobin rdf:type owl:Class ;
                rdfs:subClassOf gufo:FunctionalComplex ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:inheresIn ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :HemoglobinConcentration
                                ] .


###  http://example.com#ncitHemoglobinMeasurement
:ncitHemoglobinMeasurement rdf:type owl:Class ;
                           rdfs:subClassOf :ClinicalMeasurement ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                            ] ;
                                             owl:someValuesFrom :ncitPatient
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty gufo:wasCreatedIn ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass :HemoglobinMeasurementResult
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                            ] ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass :HemoglobinConcentration
                                           ] .


###  http://example.com#ncitMetabolicDisorder
:ncitMetabolicDisorder rdf:type owl:Class ;
                       rdfs:subClassOf :ncitDisorder .


###  http://example.com#ncitNeuropathy
:ncitNeuropathy rdf:type owl:Class ;
                rdfs:subClassOf :ncitDisorder .


###  http://example.com#ncitNurse
:ncitNurse rdf:type owl:Class ;
           rdfs:subClassOf :Person ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:mediates ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :ncitTherapeuticTherapy
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty [ owl:inverseOf gufo:participatedIn
                                            ] ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :ncitScreening
                           ] .


###  http://example.com#ncitPatient
:ncitPatient rdf:type owl:Class ;
             rdfs:subClassOf :Person ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:inheresIn ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :HemoglobinConcentration
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:mediates ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :ncitTherapeuticTherapy
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty [ owl:inverseOf gufo:participatedIn
                                              ] ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :ncitScreening
                             ] .


###  http://example.com#ncitScreening
:ncitScreening rdf:type owl:Class ;
               rdfs:subClassOf gufo:Event ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty gufo:wasCreatedIn ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :ncitHealthRiskAssessment
                               ] .


###  http://example.com#ncitTherapeuticTherapy
:ncitTherapeuticTherapy rdf:type owl:Class ;
                        rdfs:subClassOf gufo:Relator ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty [ owl:inverseOf gufo:mediates
                                                         ] ;
                                          owl:someValuesFrom :ncitNurse
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty [ owl:inverseOf gufo:mediates
                                                         ] ;
                                          owl:someValuesFrom :ncitPatient
                                        ] .


