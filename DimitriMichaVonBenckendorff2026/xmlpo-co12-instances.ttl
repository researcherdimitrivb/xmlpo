 # ExplanationIntention

:DecisionSubjectIntention
    rdf:type :ExplanationIntention ;
    gufo:inheresIn :DecisionSubjectProfile .

:CalibrateTrust
    gufo:externallyDependsOn :DecisionSubjectIntention .

:DecisionSupport
    gufo:externallyDependsOn :DecisionSubjectIntention .

:Contest
    gufo:externallyDependsOn :DecisionSubjectIntention .

:DomainExpertIntention
    rdf:type :ExplanationIntention ;
    gufo:inheresIn :DomainExpertProfile .

:DecisionSupport
    gufo:externallyDependsOn :DomainExpertIntention .

:CalibrateTrust
    gufo:externallyDependsOn :DomainExpertIntention .

:Justify
    gufo:externallyDependsOn :DomainExpertIntention .

:TechnicalCreatorIntention
    rdf:type :ExplanationIntention ;
    gufo:inheresIn :TechnicalCreatorProfile .

:Improve
    gufo:externallyDependsOn :TechnicalCreatorIntention .

:Audit
    gufo:externallyDependsOn :TechnicalCreatorIntention .

:Discover
    gufo:externallyDependsOn :TechnicalCreatorIntention .

:OperationalUserIntention
    rdf:type :ExplanationIntention ;
    gufo:inheresIn :OperationalUserProfile .

:DecisionSupport
    gufo:externallyDependsOn :OperationalUserIntention .

:CalibrateTrust
    gufo:externallyDependsOn :OperationalUserIntention .

:Improve
    gufo:externallyDependsOn :OperationalUserIntention .

:OrganisationalComplianceOverseerIntention
    rdf:type :ExplanationIntention ;
    gufo:inheresIn
        :OrganisationalComplianceOverseerProfile .

:Audit
    gufo:externallyDependsOn
        :OrganisationalComplianceOverseerIntention .

:Contest
    gufo:externallyDependsOn
        :OrganisationalComplianceOverseerIntention .

:CalibrateTrust
    gufo:externallyDependsOn
        :OrganisationalComplianceOverseerIntention .

:ResearchersTheoristIntention
    rdf:type :ExplanationIntention ;
    gufo:inheresIn :ResearchersTheoristProfile .

:Discover
    gufo:externallyDependsOn
        :ResearchersTheoristIntention .

:Improve
    gufo:externallyDependsOn
        :ResearchersTheoristIntention .

:Audit
    gufo:externallyDependsOn
        :ResearchersTheoristIntention .


