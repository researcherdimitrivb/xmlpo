@prefix : <http://example.com#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@base <http://example.com#> .

### XAIStakeholder

:DecisionSubjectProfile rdf:type :DecisionSubject .

:DomainExpertProfile rdf:type :DomainExpert .

:TechnicalCreatorProfile rdf:type :TechnicalCreator .

:OperationalUserProfile rdf:type :OperationalUser .

:OrganisationalComplianceOverseerProfile rdf:type :OrganisationalComplianceOverseer .

:ResearcherTheoristProfile rdf:type :ResearcherTheorist .


### Knowledge

:None rdf:type :KnowledgeLevels .
:Basic rdf:type :KnowledgeLevels .
:Intermediate rdf:type :KnowledgeLevels .
:Advanced rdf:type :KnowledgeLevels .
:Expert rdf:type :KnowledgeLevels .

:DecisionSubjectDomainKnowledge
    rdf:type :DomainKnowledge ;
    :level :Basic ;
    gufo:inheresIn :DecisionSubjectProfile .

:DecisionSubjectTechnicalKnowledge
    rdf:type :TechnicalKnowledge ;
    :level :Basic ;
    gufo:inheresIn :DecisionSubjectProfile .

:DomainExpertDomainKnowledge
    rdf:type :DomainKnowledge ;
    :level :Expert ;
    gufo:inheresIn :DomainExpertProfile .

:DomainExpertTechnicalKnowledge
    rdf:type :TechnicalKnowledge ;
    :level :Intermediate ;
    gufo:inheresIn :DomainExpertProfile .

:TechnicalCreatorDomainKnowledge
    rdf:type :DomainKnowledge ;
    :level :Intermediate ;
    gufo:inheresIn :TechnicalCreatorProfile .

:TechnicalCreatorTechnicalKnowledge
    rdf:type :TechnicalKnowledge ;
    :level :Expert ;
    gufo:inheresIn :TechnicalCreatorProfile .

:OperationalUserDomainKnowledge
    rdf:type :DomainKnowledge ;
    :level :Advanced ;
    gufo:inheresIn :OperationalUserProfile .

:OperationalUserTechnicalKnowledge
    rdf:type :TechnicalKnowledge ;
    :level :Intermediate ;
    gufo:inheresIn :OperationalUserProfile .

:ComplianceDomainKnowledge
    rdf:type :DomainKnowledge ;
    :level :Advanced ;
    gufo:inheresIn :OrganisationalComplianceOverseerProfile .

:ComplianceTechnicalKnowledge
    rdf:type :TechnicalKnowledge ;
    :level :Intermediate ;
    gufo:inheresIn :OrganisationalComplianceOverseerProfile .

:ResearcherDomainKnowledge
    rdf:type :DomainKnowledge ;
    :level :Advanced ;
    gufo:inheresIn :ResearcherTheoristProfile .

:ResearcherTechnicalKnowledge
    rdf:type :TechnicalKnowledge ;
    :level :Expert ;
    gufo:inheresIn :ResearcherTheoristProfile .


### Explanation Goals % (replace)

:Audit rdf:type owl:NamedIndividual , :ExplanationGoal .

:CalibrateTrust rdf:type owl:NamedIndividual , :ExplanationGoal .

:Contest rdf:type owl:NamedIndividual , :ExplanationGoal .

:DecisionSupport rdf:type owl:NamedIndividual , :ExplanationGoal .

:Discover rdf:type owl:NamedIndividual , :ExplanationGoal .

:Improve rdf:type owl:NamedIndividual , :ExplanationGoal .

:Justify rdf:type owl:NamedIndividual , :ExplanationGoal .

:Persuade rdf:type owl:NamedIndividual , :ExplanationGoal .


### Explanation Types % (replace)

:CaseBased rdf:type owl:NamedIndividual , :ExplanationType .

:Contextual rdf:type owl:NamedIndividual , :ExplanationType .

:Contrastive rdf:type owl:NamedIndividual , :ExplanationType .

:Counterfactual rdf:type owl:NamedIndividual , :ExplanationType .

:Everyday rdf:type owl:NamedIndividual , :ExplanationType .

:Scientific rdf:type owl:NamedIndividual , :ExplanationType .

:SimulationBased rdf:type owl:NamedIndividual , :ExplanationType .

:Statistical rdf:type owl:NamedIndividual , :ExplanationType .

:TraceBased rdf:type owl:NamedIndividual , :ExplanationType .

:Data rdf:type owl:NamedIndividual , :ExplanationType .

:Rationale rdf:type owl:NamedIndividual , :ExplanationType .

:SafetyAndPerformance rdf:type owl:NamedIndividual , :ExplanationType .

:Impact rdf:type owl:NamedIndividual , :ExplanationType .

:Fairness rdf:type owl:NamedIndividual , :ExplanationType .

:Responsibility rdf:type owl:NamedIndividual , :ExplanationType .


### Explanation Qualities % Replace (or not)

:Correctness rdf:type owl:NamedIndividual , :ExplanationQuality .

:Completeness rdf:type owl:NamedIndividual , :ExplanationQuality .

:Consistency rdf:type owl:NamedIndividual , :ExplanationQuality .

:Continuity rdf:type owl:NamedIndividual , :ExplanationQuality .

:Contrastivity rdf:type owl:NamedIndividual , :ExplanationQuality .

:CovariateComplexity rdf:type owl:NamedIndividual , :ExplanationQuality .

:Compactness rdf:type owl:NamedIndividual , :ExplanationQuality .

:Composition rdf:type owl:NamedIndividual , :ExplanationQuality .

:Confidence rdf:type owl:NamedIndividual , :ExplanationQuality .

:Context rdf:type owl:NamedIndividual , :ExplanationQuality .

:Coherence rdf:type owl:NamedIndividual , :ExplanationQuality .

:Controllability rdf:type owl:NamedIndividual , :ExplanationQuality .


# ExplanationGoalPriority

### Decision Subjects

:DSGoal1 rdf:type :ExplanationGoalPriority ;
    gufo:mediates :DecisionSubjectProfile , :CalibrateTrust ;
    :rank_2 1 .

:DSGoal2 rdf:type :ExplanationGoalPriority ;
    gufo:mediates :DecisionSubjectProfile , :DecisionSupport ;
    :rank_2 2 .

:DSGoal3 rdf:type :ExplanationGoalPriority ;
    gufo:mediates :DecisionSubjectProfile , :Contest ;
    :rank_2 3 .

