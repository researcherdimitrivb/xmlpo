:datasetHasFeature rdf:type owl:ObjectProperty;
    rdfs:domain :Dataset;
    rdfs:range :Feature.
:datasetHasData rdf:type owl:ObjectProperty;
    rdfs:domain :Dataset;
    rdfs:range :Data.
:preprocessingAlgorithmHasDataCleaning rdf:type owl:ObjectProperty;
    rdfs:domain :PreprocessingAlgorithm;
    rdfs:range :DataCleaning.
:datasetSplitHasTrain rdf:type owl:ObjectProperty;
    rdfs:domain :DatasetSplit;
    rdfs:range :Train.
:datasetSplitHasTest rdf:type owl:ObjectProperty;
    rdfs:domain :DatasetSplit;
    rdfs:range :Test.
:uses rdf:type owl:ObjectProperty;
    rdfs:domain :XAIEvaluationMetric;
    rdfs:range :XAIModelEvaluation;
    rdfs:label "uses"@en.
:uses_1 rdf:type owl:ObjectProperty;
    rdfs:domain :XAIEvaluationMetric;
    rdfs:range :ExplanationEvaluation;
    rdfs:label "uses"@en.
:Experiment rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:participatedIn ];
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :Goal
].
:Goal rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:participatedIn;
  owl:someValuesFrom :Experiment
].
:Addresses rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :Goal
].
:SpecifiesMeasure rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:mediates;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :Goal
].
:Implementation rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:inheresIn ];
  owl:someValuesFrom :ImplementationCharacteristic
].
:ImplementationCharacteristic rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty gufo:inheresIn;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :Implementation
].
:ParameterSetting rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:inheresIn ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :ParameterCharacteristic
].
:ParameterCharacteristic rdfs:subClassOf [
